# Analytics & verification — ALL OPTIONAL, all env-driven.
# Set these in Netlify → Site settings → Environment variables, then redeploy.
# Leave every value blank to keep the site 100% tracking-free (no third-party
# scripts, no cookies, no consent banner) — the default, privacy-first state.

# --- Cloudflare Turnstile (contact form spam protection) ---
# From the Cloudflare dashboard -> Turnstile -> the site's widget. The site key
# is public and baked in at build time; the secret key is server-only and is
# read by src/app/api/contact/route.ts. Both are required for the form to send.
# For local testing use Cloudflare's always-pass test keys:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google Search Console (no cookies, no visitor data) ---
# The verification token from Search Console → Settings → Ownership verification
# → "HTML tag" (just the content="..." value). Rendered as a <meta> tag.
GOOGLE_SITE_VERIFICATION=

# --- Cookie-based analytics (loaded ONLY after the visitor accepts consent) ---
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Tag Manager container id, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Clicky site id, e.g. 101234567
NEXT_PUBLIC_CLICKY_ID=

# --- Cookieless analytics (no consent banner required) ---
# Plausible: the domain registered in your Plausible account, e.g.
# forexmarkethours.app
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
